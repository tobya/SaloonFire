{
    "name": "tobya/saloonfire",
    "description": "Base Class for Saloon Fire Forged Class",
    "keywords": [
        "tobya",
        "laravel",
        "saloonfire"
    ],
    "homepage": "https://github.com/tobya/saloonfire",
    "license": "MIT",
    "authors": [
        {
            "name": "Toby Allen",
            "email": "tobyallen@toflidium.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "spatie/laravel-package-tools": "^1.16",
        "saloonphp/saloon": "^4.0",
        "illuminate/contracts": "^11.0||^12.0||^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.14",
        "nunomaduro/collision": "^8.8",
        "orchestra/testbench": "^11.0.0||^10.0.0||^9.0.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "spatie/laravel-ray": "^1.35"
    },
    "autoload": {
        "psr-4": {
            "Tobya\\SaloonFire\\": "src/",
            "Tobya\\SaloonFire\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tobya\\SaloonFire\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Tobya\\SaloonFire\\SaloonFireServiceProvider"
            ],
            "aliases": {
                "SaloonFire": "Tobya\\SaloonFire\\Facades\\SaloonFire"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
